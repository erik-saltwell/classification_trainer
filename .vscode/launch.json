{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "--batch",
            "type": "debugpy",
            "request": "launch",
            "module": "classification_trainer",
            "console": "integratedTerminal",
            "args": [
                "compute-batch-size",
                "--dataset",
                "rpg_reddit_post_classification",
                "--base-model",
                "qwen2.5-1.5b-instruct",
                "--training-info",
                "reddit-rpg-rules-questions-classifier",
                "--starting-batch-size",
                "1",
                "--starting-batch-size",
                "64",
                "--strategy",
                "increment_by_1",
                "--stress-set-rowcount",
                "100",
            ]
        },
        {
            "name": "--sequence",
            "type": "debugpy",
            "request": "launch",
            "module": "classification_trainer",
            "console": "integratedTerminal",
            "args": [
                "analyze-sequence-length",
                "--dataset",
                "rpg_reddit_post_classification",
                "--base-model",
                "qwen2.5-1.5b-instruct",
                "--training-info",
                "reddit-rpg-rules-questions-classifier"
            ]
        },
        {
            "name": "custom args",
            "type": "debugpy",
            "request": "launch",
            "module": "classification_trainer",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Integration Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "justMyCode": true,
            "args": [
                "-s",
                "tests/integration"
            ],
            "console": "integratedTerminal"
        }
    ]
}
