{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "--sweep",
            "type": "debugpy",
            "request": "launch",
            "module": "classification_trainer",
            "console": "integratedTerminal",
            "args": [
                "sweep",
                "--dataset",
                "test-reddit-questions",
                "--training-info",
                "test-reddit-questions",
                "--count",
                "10",
            ]
        },
        {
            "name": "--publish",
            "type": "debugpy",
            "request": "launch",
            "module": "classification_trainer",
            "console": "integratedTerminal",
            "args": [
                "publish",
                "--training-info",
                "test-reddit-questions",
            ]
        },
        {
            "name": "--train",
            "type": "debugpy",
            "request": "launch",
            "module": "classification_trainer",
            "console": "integratedTerminal",
            "args": [
                "train",
                "--dataset",
                "test-reddit-questions",
                "--training-info",
                "test-reddit-questions",
            ]
        },
        {
            "name": "--batch",
            "type": "debugpy",
            "request": "launch",
            "module": "classification_trainer",
            "console": "integratedTerminal",
            "args": [
                "compute-batch-size",
                "--dataset",
                "test-reddit-questions",
                "--training-info",
                "test-reddit-questions",
                "--stress-set-rowcount",
                "100",
            ]
        },
        {
            "name": "--dataset",
            "type": "debugpy",
            "request": "launch",
            "module": "classification_trainer",
            "console": "integratedTerminal",
            "args": [
                "analyze-dataset",
                "--dataset",
                "test-reddit-questions",
                "--training-info",
                "test-reddit-questions",
            ]
        },
        {
            "name": "custom args",
            "type": "debugpy",
            "request": "launch",
            "module": "classification_trainer",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Integration Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "justMyCode": true,
            "args": [
                "-s",
                "tests/integration"
            ],
            "console": "integratedTerminal"
        }
    ]
}
